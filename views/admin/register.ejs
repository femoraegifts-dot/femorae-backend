<!DOCTYPE html>
<html>
<head>
  <title>Student Register</title>
  <link rel="stylesheet" href="/admin.css">
</head>
<body>

<%- include('../partials/header') %>

<div style="display:flex;">
  <%- include('../partials/sidebar') %>

  <div style="padding:20px; flex:1; min-width:0;">

    <h2>Student Register</h2>

    <p>
      Showing <strong><%= students.length %></strong>
      of <strong><%= total %></strong> students
      (page <strong><%= page %></strong>
      of <strong><%= totalPages %></strong>)
    </p>

    <!-- =========================================
         SUMMARY CARDS (same filters as table)
         approved = approved_status 'approved';
         pending = every other active student.
    ========================================== -->

    <div style="display:flex; gap:12px; margin-bottom:20px;">

      <div style="border:1px solid #ccc; border-radius:8px;
                  padding:10px 16px; min-width:110px;">
        <div style="font-size:12px; color:#666;">Total</div>
        <div style="font-size:22px; font-weight:bold;">
          <%= summary.total %>
        </div>
      </div>

      <div style="border:1px solid #4caf50; border-radius:8px;
                  padding:10px 16px; min-width:110px;">
        <div style="font-size:12px; color:#2e7d32;">Approved</div>
        <div style="font-size:22px; font-weight:bold; color:#2e7d32;">
          <%= summary.approved %>
        </div>
      </div>

      <div style="border:1px solid #ff9800; border-radius:8px;
                  padding:10px 16px; min-width:110px;">
        <div style="font-size:12px; color:#ef6c00;">Pending</div>
        <div style="font-size:22px; font-weight:bold; color:#ef6c00;">
          <%= summary.pending %>
        </div>
      </div>

    </div>

    <!-- =========================================
         FILTERS
    ========================================== -->

    <form method="GET" action="/admin/register"
          style="margin-bottom:20px;">

      <!-- SCHOOL -->
      <label>School:</label>
      <select id="school" name="school_id">
        <option value="">All Schools</option>

        <% schools.forEach(s => { %>
          <option value="<%= s.id %>"
            <%= String(filters.school_id) === String(s.id) ? "selected" : "" %>>
            <%= s.name %>
          </option>
        <% }) %>

      </select>

      <!-- CLASS -->
      <label>Class:</label>
      <select id="class" name="class_id">
        <option value="">All Classes</option>

        <% classes.forEach(c => { %>
          <option value="<%= c.id %>"
            <%= String(filters.class_id) === String(c.id) ? "selected" : "" %>>
            <%= c.class_name %>
          </option>
        <% }) %>

      </select>

      <!-- DIVISION -->
      <label>Division:</label>
      <select id="division" name="division_id">
        <option value="">All Divisions</option>

        <% divisions.forEach(d => { %>
          <option value="<%= d.id %>"
            <%= String(filters.division_id) === String(d.id) ? "selected" : "" %>>
            <%= d.division_name %>
          </option>
        <% }) %>

      </select>

      <br/><br/>

      <!-- SEARCH -->
      <label>Search name / admission no:</label>
      <input type="text" name="q"
             value="<%= filters.q %>"
             placeholder="Type to search"
             style="padding:8px;">

      <!-- PHOTO STATUS -->
      <label>Photo:</label>
      <select name="photo_status">
        <option value="">All</option>
        <option value="pending"
          <%= filters.photo_status === "pending" ? "selected" : "" %>>
          Pending
        </option>
        <option value="completed"
          <%= filters.photo_status === "completed" ? "selected" : "" %>>
          Completed
        </option>
      </select>

      <!-- APPROVAL STATUS -->
      <label>Approval:</label>
      <select name="approved_status">
        <option value="">All</option>
        <option value="approved"
          <%= filters.approved_status === "approved" ? "selected" : "" %>>
          Approved
        </option>
        <option value="pending"
          <%= filters.approved_status === "pending" ? "selected" : "" %>>
          Pending
        </option>
      </select>

      <button type="submit" style="padding:8px 12px;">
        Filter
      </button>

      <a href="/admin/register" style="margin-left:10px;">
        Clear
      </a>

    </form>

    <!-- =========================================
         REGISTER TABLE (sticky header, scrollable)
    ========================================== -->

    <div style="max-height:60vh; overflow:auto; border:1px solid #ccc;">

    <table border="1"
           cellpadding="8"
           cellspacing="0"
           width="100%"
           style="min-width:900px; border-collapse:collapse;">

      <thead>
        <tr>
          <th style="position:sticky; top:0; background:#f0f0f0;">DB ID</th>
          <th style="position:sticky; top:0; background:#f0f0f0;">Admission No</th>
          <th style="position:sticky; top:0; background:#f0f0f0;">Name</th>
          <th style="position:sticky; top:0; background:#f0f0f0;">School</th>
          <th style="position:sticky; top:0; background:#f0f0f0;">Class</th>
          <th style="position:sticky; top:0; background:#f0f0f0;">Division</th>
          <th style="position:sticky; top:0; background:#f0f0f0;">Photo</th>
          <th style="position:sticky; top:0; background:#f0f0f0;">Approval</th>
          <th style="position:sticky; top:0; background:#f0f0f0;">Updated</th>
          <th style="position:sticky; top:0; background:#f0f0f0;">Detail</th>
        </tr>
      </thead>

      <tbody>

        <% students.forEach(student => { %>

          <tr>

            <td>
              <%= student.id %>
            </td>

            <td>
              <%= student.admission_no || '' %>
            </td>

            <td>
              <%= student.student_name || '' %>
            </td>

            <td>
              <%= student.school_name || '-' %>
            </td>

            <td>
              <%= student.class_name || '-' %>
            </td>

            <td>
              <%= student.division_name || '-' %>
            </td>

            <td>

              <% if (student.photo_status === 'completed') { %>

                <span style="color:green;">Completed</span>

              <% } else if (student.photo_status === 'skipped') { %>

                <span style="color:grey;">Skipped</span>

              <% } else { %>

                <span style="color:orange;">Pending</span>

              <% } %>

              <% if (student.photo_url) { %>

                <br>
                <a href="<%= student.photo_url %>" target="_blank">
                  <img src="<%= student.photo_url %>"
                       alt="photo"
                       width="50">
                </a>

              <% } %>

            </td>

            <td>

              <% if (student.approved_status === 'approved') { %>

                <span style="color:green; font-weight:bold;">
                  Approved
                </span>

              <% } else { %>

                <span style="color:orange; font-weight:bold;">
                  Pending
                </span>

              <% } %>

            </td>

            <td>
              <%= student.updated_at || '' %>
            </td>

            <td>
              <a href="/admin/student/<%= student.id %>">
                View
              </a>
            </td>

          </tr>

        <% }) %>

        <% if (students.length === 0) { %>

          <tr>
            <td colspan="10" style="text-align:center;">
              No students match the current filters.
            </td>
          </tr>

        <% } %>

      </tbody>

    </table>

    </div>

    <!-- =========================================
         FILTERED EXCEL EXPORT (existing route)
         Requires school + class + division,
         exactly like the Exports page.
    ========================================== -->

    <div style="margin-top:15px;">

      <% if (filters.school_id && filters.class_id && filters.division_id) { %>

        <a href="/students/export/excel?school_id=<%= filters.school_id %>&class_id=<%= filters.class_id %>&division_id=<%= filters.division_id %><% if (filters.q) { %>&q=<%= encodeURIComponent(filters.q) %><% } %><% if (filters.photo_status) { %>&photo_status=<%= filters.photo_status %><% } %><% if (filters.approved_status) { %>&approved_status=<%= filters.approved_status %><% } %>">
          Download filtered Excel
        </a>

      <% } else { %>

        <span style="color:#666;">
          Select a school, class and division to enable filtered Excel download.
        </span>

      <% } %>

    </div>

    <!-- =========================================
         PAGINATION (filters preserved)
    ========================================== -->

    <div style="margin-top:15px;">

      <% if (page > 1) { %>
        <a href="/admin/register?<%= queryBase %>page=<%= page - 1 %>">
          &laquo; Previous
        </a>
      <% } %>

      <span style="margin:0 10px;">
        Page <%= page %> of <%= totalPages %>
      </span>

      <% if (page < totalPages) { %>
        <a href="/admin/register?<%= queryBase %>page=<%= page + 1 %>">
          Next &raquo;
        </a>
      <% } %>

    </div>

  </div>
</div>

<script>
document.getElementById("school").addEventListener("change", async function () {
  const schoolId = this.value;

  const classDropdown = document.getElementById("class");
  const divisionDropdown = document.getElementById("division");

  classDropdown.innerHTML = '<option value="">All Classes</option>';
  divisionDropdown.innerHTML = '<option value="">All Divisions</option>';

  if (!schoolId) return;

  try {
    const res = await fetch(`/admin/api/classes/${schoolId}`);
    const data = await res.json();

    data.forEach(c => {
      const option = document.createElement("option");
      option.value = c.id;
      option.textContent = c.class_name;
      classDropdown.appendChild(option);
    });
  } catch (err) {
    console.error("Class load error:", err);
  }
});

document.getElementById("class").addEventListener("change", async function () {
  const classId = this.value;

  const divisionDropdown = document.getElementById("division");
  divisionDropdown.innerHTML = '<option value="">All Divisions</option>';

  if (!classId) return;

  try {
    const res = await fetch(`/admin/api/divisions/${classId}`);
    const data = await res.json();

    data.forEach(d => {
      const option = document.createElement("option");
      option.value = d.id;
      option.textContent = d.division_name;
      divisionDropdown.appendChild(option);
    });
  } catch (err) {
    console.error("Division load error:", err);
  }
});
</script>

</body>
</html>
